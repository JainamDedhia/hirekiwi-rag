# ==============================================================================
# HireKiwi Corrective RAG (CRAG) Environment Configuration
# ==============================================================================

# Application Settings
APP_NAME=HireKiwi-CRAG
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# LLM Gateway Configuration
# Options: "openai", "groq", "ollama", "mock"
# Default is "openai" when key is present, falls back automatically to "mock" for zero-cost offline test/dev
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# API Keys (Provide one of the following for live inference)
OPENAI_API_KEY=sk-your-openai-api-key-here
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Web Search Fallback Configuration
# Options: "duckduckgo", "tavily", "mock"
# "duckduckgo" requires NO api key and works out of the box!
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=tvly-your-tavily-api-key-here
SEARCH_MAX_RESULTS=3

# Vector Store & Embedding Configuration
# Options: "sentence-transformers", "openai"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
SAMPLE_DOCS_DIR=./data/sample_documents

# CRAG Retrieval & Grading Parameters
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.5
REWRITE_QUERY_ENABLED=true
STRICT_GRADING=false
